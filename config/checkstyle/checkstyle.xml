<?xml version="1.0" encoding="UTF-8"?>
<!-- Lean Checkstyle ruleset: structural/hygiene checks ONLY.
     Formatting (indentation, import order, whitespace) is owned by
     spring-javaformat — do not duplicate it here. -->
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>
  <module name="NewlineAtEndOfFile"/>
  <module name="FileLength">
    <property name="max" value="800"/>
  </module>
  <module name="LineLength">
    <property name="max" value="140"/>
    <property name="ignorePattern" value="^package.*|^import.*|https?://\S+$"/>
  </module>
  <module name="RegexpSingleline">
    <property name="format" value="System\.(out|err)\.print"/>
    <property name="message" value="Use a Logger, not System.out/err."/>
  </module>
  <module name="TreeWalker">
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="NeedBraces"/>
    <module name="EmptyStatement"/>
    <module name="EqualsHashCode"/>
    <module name="VisibilityModifier">
      <property name="allowPublicFinalFields" value="true"/>
    </module>
    <module name="DeclarationOrder"/>
    <module name="FinalClass"/>
    <!-- No HideUtilityClassConstructor: flags @SpringBootApplication entry points.
         No ConstantName: loggers are conventionally `private static final Logger log`. -->
    <module name="OneTopLevelClass"/>
    <module name="TypeName"/>
    <module name="MemberName"/>
    <module name="MethodName"/>
    <module name="ParameterName"/>
  </module>
</module>
