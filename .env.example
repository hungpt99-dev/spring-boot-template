# Local environment template. The app does NOT read .env files natively.
# Copy to .env (gitignored), then source it before running:
#   sh:  set -a; . ./.env; set +a
#   IDE: paste values into the run configuration's environment variables.
# Preferred: export real secrets via your shell or secret manager, never commit them.
DB_URL=jdbc:postgresql://localhost:5432/app
DB_USER=app
DB_PASSWORD=change-me
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
JWT_ISSUER_URI=
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACING_SAMPLING_PROBABILITY=0.1
# Enable modules per environment, e.g.:
# APP_MODULES_PERSISTENCE_ENABLED=true
# APP_MODULES_KAFKA_ENABLED=true
